{
  "name": "utility",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "description": "Some utilities for JavaScript & TypeScript projects",
  "author": {
    "name": "qingshaner",
    "url": "https://github.com/Jon-a-than"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tsingshaner/utility.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "changeset-version": "changeset version && pnpx @qingshaner/jsr-release version --allowDirty --sync",
    "changeset-publish": "changeset publish",
    "check": "biome check . --write",
    "check:cspell": "cspell . --no-summary --no-progress --gitignore",
    "check:type": "tsc --build --noEmit",
    "check:knip": "knip",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^2.31.1",
    "@qingshaner/devtools": "^0.0.3",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "cspell": "^10.3.1",
    "knip": "^6.35.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged",
    "pre-push": "pnpm run '/(test|check|check:cspell|check:type|check:knip)/'"
  },
  "nano-staged": {
    "*": "pnpm cspell --no-summary --no-progress --no-must-find-files --file-list",
    "*.{json,jsonc,js,jsx,cjs,mjs,ts,tsx,cts,mts,html,svg,css,vue}": "pnpm biome check --fix --files-ignore-unknown=true --no-errors-on-unmatched"
  }
}
